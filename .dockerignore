# Docker ignore file for Speech Recognition project

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Large dataset files (will be mounted as volumes)
commonvoice/
output/
logs/
uploads/

# Model checkpoints (will be in mounted volumes)
*.pth
*.pt
*.model
*.vocab

# Audio files
*.wav
*.mp3
*.m4a
*.flac

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Other unnecessary files for Docker build
sample.md
run.py
main.py
wer.py
